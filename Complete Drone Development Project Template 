### src/computer_vision/object_tracker.py
```python
"""
Real-time object tracking using OpenCV
"""
import cv2
import numpy as np

class ObjectTracker:
    def __init__(self, color_lower, color_upper):
        """Initialize tracker with HSV color range"""
        self.color_lower = np.array(color_lower)
        self.color_upper = np.array(color_upper)
        self.target_position = None
    
    def process_frame(self, frame):
        """Process video frame and detect target"""
        hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)
        mask = cv2.inRange(hsv, self.color_lower, self.color_upper)
        
        # Find contours
        contours, _ = cv2.findContours(mask, cv2.RETR_TREE, cv2.CHAIN_APPROX_SIMPLE)
        
        if contours:
            # Find largest contour
            largest_contour = max(contours, key=cv2.contourArea)
            
            # Calculate center
            M = cv2.moments(largest_contour)
            if M["m00"] != 0:
                cx = int(M["m10"] / M["m00"])
                cy = int(M["m01"] / M["m00"])
                self.target_position = (cx, cy)
                
                # Draw on frame
                cv2.circle(frame, (cx, cy), 10, (0, 255, 0), -1)
                cv2.drawContours(frame, [largest_contour], -1, (0, 255, 0), 2)
        
        return frame, mask
    
    def get_target_offset(self, frame_width, frame_height):
        """Calculate offset from center"""
        if self.target_position:
            cx, cy = self.target_position
            offset_x = (cx - frame_width / 2) / (frame_width / 2)
            offset_y = (cy - frame_height / 2) / (frame_height / 2)
            return offset_x, offset_y
        return None, None

# Example usage
if __name__ == "__main__":
    # Track red objects
    tracker = ObjectTracker([0, 120, 70], [10, 255, 255])
    
    cap = cv2.VideoCapture(0)
    
    while True:
        ret, frame = cap.read()
        if not ret:
            break
        
        processed_frame, mask = tracker.process_frame(frame)
        offset_x, offset_y = tracker.get_target_offset(frame.shape[1], frame.shape[0])
        
        if offset_x is not None:
            print(f"Target offset: X={offset_x:.2f}, Y={offset_y:.2f}")
        
        cv2.imshow('Tracking', processed_frame)
        cv2.imshow('Mask', mask)
        
        if cv2.waitKey(1) & 0xFF == ord('q'):
            break
    
    cap.release()
    cv2.destroyAllWindows()
