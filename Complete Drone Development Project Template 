### examples/basic_takeoff.py
```python
"""
Simple takeoff and land example
"""
import sys
sys.path.append('./src')

from flight_control.basic_flight import DroneController
import time

def main():
    # Connect to drone (SITL simulator)
    drone = DroneController('127.0.0.1:14550')
    
    try:
        # Print telemetry
        telemetry = drone.get_telemetry()
        print("Current telemetry:")
        for key, value in telemetry.items():
            print(f"  {key}: {value}")
        
        # Takeoff to 10 meters
        drone.arm_and_takeoff(10)
        
        # Hover for 10 seconds
        print("Hovering...")
        time.sleep(10)
        
        # Return to launch and land
        drone.return_to_launch()
        
        # Wait for landing
        print("Waiting for landing...")
        while drone.vehicle.armed:
            alt = drone.vehicle.location.global_relative_frame.alt
            print(f"Altitude: {alt:.1f}m")
            time.sleep(1)
        
        print("Landed successfully!")
        
    except KeyboardInterrupt:
        print("Interrupted! Landing...")
        drone.land()
    finally:
        drone.close()

if __name__ == "__main__":
    main()
```

