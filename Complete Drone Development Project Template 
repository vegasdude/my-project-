### src/flight_control/basic_flight.py
```python
"""
Basic flight control module
"""
from dronekit import connect, VehicleMode, LocationGlobalRelative
import time
import yaml

class DroneController:
    def __init__(self, connection_string, config_path='config/drone_config.yaml'):
        """Initialize drone controller"""
        with open(config_path, 'r') as f:
            self.config = yaml.safe_load(f)
        
        print(f"Connecting to drone at {connection_string}...")
        self.vehicle = connect(connection_string, wait_ready=True)
        print("Connected!")
        
    def arm_and_takeoff(self, target_altitude):
        """Arm and takeoff to target altitude"""
        print("Pre-flight checks...")
        
        # Check if vehicle is armable
        while not self.vehicle.is_armable:
            print("Waiting for vehicle to initialize...")
            time.sleep(1)
        
        print("Arming motors...")
        self.vehicle.mode = VehicleMode("GUIDED")
        self.vehicle.armed = True
        
        while not self.vehicle.armed:
            print("Waiting for arming...")
            time.sleep(1)
        
        print(f"Taking off to {target_altitude}m...")
        self.vehicle.simple_takeoff(target_altitude)
        
        # Wait to reach target altitude
        while True:
            current_alt = self.vehicle.location.global_relative_frame.alt
            print(f"Altitude: {current_alt:.1f}m")
            
            if current_alt >= target_altitude * 0.95:
                print("Target altitude reached!")
                break
            time.sleep(1)
    
    def goto_position(self, lat, lon, alt):
        """Navigate to GPS coordinates"""
        point = LocationGlobalRelative(lat, lon, alt)
        print(f"Going to: {lat}, {lon}, {alt}m")
        self.vehicle.simple_goto(point)
    
    def return_to_launch(self):
        """Return to launch position and land"""
        print("Returning to launch...")
        self.vehicle.mode = VehicleMode("RTL")
    
    def land(self):
        """Land at current position"""
        print("Landing...")
        self.vehicle.mode = VehicleMode("LAND")
    
    def get_telemetry(self):
        """Get current telemetry data"""
        return {
            'mode': self.vehicle.mode.name,
            'armed': self.vehicle.armed,
            'altitude': self.vehicle.location.global_relative_frame.alt,
            'latitude': self.vehicle.location.global_frame.lat,
            'longitude': self.vehicle.location.global_frame.lon,
            'heading': self.vehicle.heading,
            'groundspeed': self.vehicle.groundspeed,
            'airspeed': self.vehicle.airspeed,
            'battery': self.vehicle.battery.level,
            'gps': self.vehicle.gps_0.fix_type
        }
    
    def close(self):
        """Close vehicle connection"""
        self.vehicle.close()
        print("Connection closed.")

if __name__ == "__main__":
    # Test basic flight
    drone = DroneController('127.0.0.1:14550')
    
    try:
        drone.arm_and_takeoff(10)
        time.sleep(10)
        drone.return_to_launch()
        
        # Wait for landing
        while drone.vehicle.armed:
            time.sleep(1)
    finally:
        drone.close()
```

