### src/flight_control/waypoint_navigation.py
```python
"""
Waypoint navigation and mission planning
"""
from dronekit import connect, VehicleMode, LocationGlobalRelative, Command
from pymavlink import mavutil
import time

class MissionPlanner:
    def __init__(self, vehicle):
        self.vehicle = vehicle
        self.waypoints = []
    
    def add_waypoint(self, lat, lon, alt):
        """Add a waypoint to the mission"""
        self.waypoints.append(LocationGlobalRelative(lat, lon, alt))
        print(f"Added waypoint: {lat}, {lon}, {alt}m")
    
    def upload_mission(self):
        """Upload mission to vehicle"""
        cmds = self.vehicle.commands
        cmds.clear()
        
        # Add takeoff command
        home = self.vehicle.location.global_frame
        cmds.add(Command(0, 0, 0, 
                        mavutil.mavlink.MAV_FRAME_GLOBAL_RELATIVE_ALT,
                        mavutil.mavlink.MAV_CMD_NAV_TAKEOFF,
                        0, 0, 0, 0, 0, 0,
                        home.lat, home.lon, 10))
        
        # Add waypoints
        for wp in self.waypoints:
            cmds.add(Command(0, 0, 0,
                           mavutil.mavlink.MAV_FRAME_GLOBAL_RELATIVE_ALT,
                           mavutil.mavlink.MAV_CMD_NAV_WAYPOINT,
                           0, 0, 0, 0, 0, 0,
                           wp.lat, wp.lon, wp.alt))
        
        # Add RTL
        cmds.add(Command(0, 0, 0,
                        mavutil.mavlink.MAV_FRAME_GLOBAL_RELATIVE_ALT,
                        mavutil.mavlink.MAV_CMD_NAV_RETURN_TO_LAUNCH,
                        0, 0, 0, 0, 0, 0, 0, 0, 0))
        
        print(f"Uploading {len(cmds)} commands...")
        cmds.upload()
        print("Mission uploaded!")
    
    def execute_mission(self):
        """Execute uploaded mission"""
        print("Arming and starting mission...")
        self.vehicle.mode = VehicleMode("GUIDED")
        self.vehicle.armed = True
        
        while not self.vehicle.armed:
            time.sleep(1)
        
        print("Switching to AUTO mode...")
        self.vehicle.mode = VehicleMode("AUTO")
        
        # Monitor mission progress
        while self.vehicle.commands.next < self.vehicle.commands.count:
            nextwaypoint = self.vehicle.commands.next
            print(f"Going to waypoint {nextwaypoint}...")
            time.sleep(5)
        
        print("Mission complete!")

# Example usage
if __name__ == "__main__":
    vehicle = connect('127.0.0.1:14550', wait_ready=True)
    
    mission = MissionPlanner(vehicle)
    mission.add_waypoint(37.7749, -122.4194, 20)
    mission.add_waypoint(37.7750, -122.4195, 20)
    mission.add_waypoint(37.7751, -122.4196, 20)
    mission.upload_mission()
    mission.execute_mission()
    
    vehicle.close()
```

