class SwarmController:
    def __init__(self, num_drones):
        self.positions = np.random.rand(num_drones, 3) * 10
        self.velocities = np.zeros((num_drones, 3))
        self.safe_distance = 2.0
    
    def update(self, dt=0.1):
        # Separation: avoid crowding neighbors
        separation = self.separation_force()
        
        # Alignment: steer towards average heading
        alignment = self.alignment_force()
        
        # Cohesion: steer towards average position
        cohesion = self.cohesion_force()
        
        # Update velocities and positions
        self.velocities += (separation + alignment + cohesion) * dt
        self.positions += self.velocities * dt
    
    def separation_force(self):
        force = np.zeros_like(self.positions)
        for i in range(len(self.positions)):
            for j in range(len(self.positions)):
                if i != j:
                    diff = self.positions[i] - self.positions[j]
                    dist = np.linalg.norm(diff)
                    if dist < self.safe_distance:
                        force[i] += diff / (dist ** 2)
        return force
    
    def alignment_force(self):
        avg_vel = np.mean(self.velocities, axis=0)
        return avg_vel - self.velocities
    
    def cohesion_force(self):
        center = np.mean(self.positions, axis=0)
        return center - self.positions

# Usage
swarm = SwarmController(num_drones=10)
for _ in range(100):
    swarm.update()
    print(f"Positions: {swarm.positions}")`
