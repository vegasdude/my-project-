from collections import deque

def a_star(start, goal, obstacles, grid_size=100):
    """Simple A* implementation"""
    open_set = [(start, 0, heuristic(start, goal))]
    closed_set = set()
    came_from = {}
    g_score = {start: 0}
    
    while open_set:
        open_set.sort(key=lambda x: x[2])
        current, g, f = open_set.pop(0)
        
        if current == goal:
            # Reconstruct path
            path = []
            while current in came_from:
                path.append(current)
                current = came_from[current]
            return path[::-1]
        
        closed_set.add(current)
        
        for neighbor in get_neighbors(current, grid_size):
            if neighbor in closed_set or neighbor in obstacles:
                continue
            
            tentative_g = g_score[current] + 1
            
            if neighbor not in g_score or tentative_g < g_score[neighbor]:
                came_from[neighbor] = current
                g_score[neighbor] = tentative_g
                f_score = tentative_g + heuristic(neighbor, goal)
                open_set.append((neighbor, tentative_g, f_score))
    
    return None

def heuristic(a, b):
    return abs(a[0] - b[0]) + abs(a[1] - b[1])

def get_neighbors(pos, size):
    x, y = pos
    neighbors = []
    for dx, dy in [(-1,0), (1,0), (0,-1), (0,1)]:
        nx, ny = x + dx, y + dy
        if 0 <= nx < size and 0 <= ny < size:
            neighbors.append((nx, ny))
    return neighbors`
