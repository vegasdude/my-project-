# MSP message format
MSP_STATUS = 101
MSP_RC = 105

def send_msp_request(ser, cmd):
    # Build MSP request
    msg = struct.pack('<BBBB', ord('$'), ord('M'), ord('<'), 0)
    msg += struct.pack('<B', cmd)
    
    checksum = 0
    for b in msg[3:]:
