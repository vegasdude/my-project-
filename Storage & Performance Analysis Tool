class MonteCarloSimulator:
    """Monte Carlo simulation examples"""
    
    @staticmethod
    def estimate_pi(num_samples: int = 1000000) -> Dict:
        """Estimate Pi using Monte Carlo method"""
        inside_circle = 0
        
        start = time.perf_counter()
        
        for _ in range(num_samples):
            x = random.uniform(-1, 1)
            y = random.uniform(-1, 1)
            if x*x + y*y <= 1:
                inside_circle += 1
        
        elapsed = time.perf_counter() - start
        pi_estimate = 4 * inside_circle / num_samples
        
        return {
            'samples': num_samples,
            'pi_estimate': pi_estimate,
            'actual_pi': 3.14159265359,
            'error': abs(pi_estimate - 3.14159265359),
            'time_seconds': elapsed
        }
    
    @staticmethod
    def random_walk_2d(steps: int = 1000) -> Dict:
        """Simulate a 2D random walk"""
        x, y = 0, 0
        positions = [(x, y)]
        
        for _ in range(steps):
            direction = random.choice(['N', 'S', 'E', 'W'])
            if direction == 'N':
                y += 1
            elif direction == 'S':
                y -= 1
            elif direction == 'E':
                x += 1
            elif direction == 'W':
                x -= 1
            positions.append((x, y))
        
        distance_from_origin = (x**2 + y**2) ** 0.5
        
        return {
            'steps': steps,
            'final_position': (x, y),
            'distance_from_origin': distance_from_origin,
            'path': positions[:10]  # First 10 positions as sample
        }
    
    @staticmethod
    def stock_price_simulation(initial_price: float, days: int, volatility: float = 0.02) -> List[float]:
        """Simulate stock price movement using geometric Brownian motion"""
        prices = [initial_price]
        
        for _ in range(days):
            change = random.gauss(0, volatility)
            new_price = prices[-1] * (1 + change)
            prices.append(max(new_price, 0.01))  # Prevent negative prices
        
        return prices


class PhysicsSimulator:
    """Physics simulation examples"""
    
    @staticmethod
    def projectile_motion(velocity: float, angle_degrees: float, time_step: float = 0.1) -> List[Dict]:
        """Simulate projectile motion"""
        import math
        
        angle_rad = math.radians(angle_degrees)
        vx = velocity * math.cos(angle_rad)
        vy = velocity * math.sin(angle_rad)
        
        x, y = 0, 0
        g = 9.81  # gravity
        trajectory = []
        
        while y >= 0:
            trajectory.append({'time': len(trajectory) * time_step, 'x': x, 'y': y})
            x += vx * time_step
            y += vy * time_step
            vy -= g * time_step
        
        return trajectory
    
    @staticmethod
    def simple_pendulum(length: float, initial_angle: float, steps: int = 100) -> List[Dict]:
        """Simulate simple pendulum motion"""
        import math
        
        g = 9.81
        theta = math.radians(initial_angle)
        omega = 0  # angular velocity
        dt = 0.01
        
        positions = []
        
        for i in range(steps):
            positions.append({
                'step': i,
                'angle_degrees': math.degrees(theta),
                'angular_velocity': omega
            })
            
            # Simple Euler integration
            alpha = -(g / length) * math.sin(theta)
            omega += alpha * dt
            theta += omega * dt
        
        return positions


