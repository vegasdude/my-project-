import time
import random
import os
import sys
from typing import List, Dict

# ============================================================================
# 1. STORAGE UTILITIES (Terabytes)
# ============================================================================

class StorageAnalyzer:
    """Tools for analyzing and converting storage units"""
    
    @staticmethod
    def convert_bytes(bytes_size: int) -> Dict[str, float]:
        """Convert bytes to various units"""
        return {
            'bytes': bytes_size,
            'KB': bytes_size / 1024,
            'MB': bytes_size / (1024 ** 2),
            'GB': bytes_size / (1024 ** 3),
            'TB': bytes_size / (1024 ** 4),
            'PB': bytes_size / (1024 ** 5)
        }
    
    @staticmethod
    def format_size(bytes_size: int) -> str:
        """Format bytes into human-readable size"""
        for unit in ['B', 'KB', 'MB', 'GB', 'TB', 'PB']:
            if bytes_size < 1024.0:
                return f"{bytes_size:.2f} {unit}"
            bytes_size /= 1024.0
        return f"{bytes_size:.2f} EB"
    
    @staticmethod
    def estimate_file_count(total_storage_tb: float, avg_file_size_mb: float) -> int:
        """Estimate how many files fit in given storage"""
        total_mb = total_storage_tb * 1024 * 1024
        return int(total_mb / avg_file_size_mb)
    
    @staticmethod
    def analyze_directory(path: str = ".") -> Dict:
        """Analyze storage usage of a directory"""
        total_size = 0
        file_count = 0
        
        try:
            for dirpath, dirnames, filenames in os.walk(path):
                for filename in filenames:
                    filepath = os.path.join(dirpath, filename)
                    try:
                        total_size += os.path.getsize(filepath)
                        file_count += 1
                    except:
                        pass
        except:
            pass
        
        return {
            'total_size_bytes': total_size,
            'total_size_formatted': StorageAnalyzer.format_size(total_size),
            'file_count': file_count,
            'avg_file_size': StorageAnalyzer.format_size(total_size / file_count) if file_count > 0 else "0 B"
        }


# ============================================================================
# 2. PERFORMANCE BENCHMARKING (Petaflops/FLOPS)
# ============================================================================

class PerformanceBenchmark:
    """Tools for measuring computational performance"""
    
    @staticmethod
    def benchmark_floating_point_ops(iterations: int = 10000000) -> Dict[str, float]:
        """Benchmark floating-point operations per second"""
        operations = ['+', '-', '*', '/']
        results = {}
        
        for op in operations:
            start = time.perf_counter()
            a, b = 1.5, 2.5
            
            if op == '+':
                for _ in range(iterations):
                    c = a + b
            elif op == '-':
                for _ in range(iterations):
                    c = a - b
            elif op == '*':
                for _ in range(iterations):
                    c = a * b
            elif op == '/':
                for _ in range(iterations):
                    c = a / b
            
            elapsed = time.perf_counter() - start
            flops = iterations / elapsed
            
            results[f'{op}_operation'] = {
                'FLOPS': flops,
                'MFLOPS': flops / 1e6,
                'GFLOPS': flops / 1e9,
                'time_seconds': elapsed
            }
        
        return results
    
    @staticmethod
    def matrix_multiply_benchmark(size: int = 100) -> Dict:
        """Benchmark matrix multiplication performance"""
        # Create random matrices
        matrix_a = [[random.random() for _ in range(size)] for _ in range(size)]
        matrix_b = [[random.random() for _ in range(size)] for _ in range(size)]
        
        start = time.perf_counter()
        
        # Perform matrix multiplication
        result = [[0 for _ in range(size)] for _ in range(size)]
        for i in range(size):
            for j in range(size):
                for k in range(size):
                    result[i][j] += matrix_a[i][k] * matrix_b[k][j]
        
        elapsed = time.perf_counter() - start
        
        # Calculate FLOPS (2 ops per multiply-add, size^3 operations)
        operations = 2 * (size ** 3)
        flops = operations / elapsed
        
        return {
            'matrix_size': f"{size}x{size}",
            'operations': operations,
            'time_seconds': elapsed,
            'FLOPS': flops,
            'MFLOPS': flops / 1e6,
            'GFLOPS': flops / 1e9
        }


