from typing import Tuple, Dict
import math

class AirspaceChecker:
    """Check if location is safe for drone flight"""
    
    def __init__(self):
        self.airports = self.load_airport_data()
        self.tfr_api = "https://tfr.faa.gov/tfr2/list.html"
        
    def load_airport_data(self):
        """Load airport database (simplified - use real FAA data in production)"""
        # This would load from FAA database
        # Using sample data here
        return [
            {"name": "LAX", "lat": 33.9416, "lon": -118.4085, "class": "B", "radius": 30},
            {"name": "SFO", "lat": 37.6213, "lon": -122.3790, "class": "B", "radius": 30},
            # Add more airports...
        ]
    
    def check_location(self, lat: float, lon: float, altitude: float) -> Dict:
        """
        Check if location is compliant for flight
        
        Args:
            lat: Latitude in degrees
            lon: Longitude in degrees
            altitude: Planned altitude in feet AGL
            
        Returns:
            Dictionary with compliance status and warnings
        """
        result = {
            "compliant": True,
            "warnings": [],
            "errors": [],
            "airspace_class": "G",
            "laanc_required": False,
            "nearest_airport": None
        }
        
        # Check altitude
        if altitude > 400:
            result["compliant"] = False
            result["errors"].append(f"Altitude {altitude}ft exceeds 400ft AGL limit")
        
        # Check distance from airports
        nearest = self.find_nearest_airport(lat, lon)
        if nearest:
            result["nearest_airport"] = nearest
            distance = nearest["distance"]
            airport_class = nearest["class"]
            
            if airport_class == "B" and distance < 30:
                result["compliant"] = False
                result["errors"].append(
                    f"Within Class B airspace of {nearest['name']} "
                    f"({distance:.1f}nm). LAANC authorization required."
                )
                result["laanc_required"] = True
                result["airspace_class"] = "B"
                
            elif airport_class in ["C", "D"] and distance < 10:
                result["warnings"].append(
                    f"Within controlled airspace of {nearest['name']} "
                    f"({distance:.1f}nm). LAANC authorization required."
                )
                result["laanc_required"] = True
                result["airspace_class"] = airport_class
                
            elif distance < 5:
                result["warnings"].append(
                    f"Within 5nm of {nearest['name']}. "
                    f"Notify airport/ATC if recreational flight."
                )
        
        # Check for TFRs (in production, call real FAA API)
        # tfr_check = self.check_tfrs(lat, lon)
        # if tfr_check:
        #     result["compliant"] = False
        #     result["errors"].append("Active TFR in area")
        
        return result
    
    def find_nearest_airport(self, lat: float, lon: float) -> Dict:
        """Find nearest airport and calculate distance"""
        nearest = None
        min_distance = float('inf')
        
        for airport in self.airports:
            distance = self.calculate_distance(
                lat, lon,
                airport["lat"], airport["lon"]
            )
            
            if distance < min_distance:
                min_distance = distance
                nearest = airport.copy()
                nearest["distance"] = distance
        
        return nearest
    
    def calculate_distance(self, lat1: float, lon1: float, 
                          lat2: float, lon2: float) -> float:
        """Calculate distance in nautical miles"""
        # Haversine formula
        R = 3440.065  # Earth radius in nautical miles
        
        lat1, lon1, lat2, lon2 = map(math.radians, [lat1, lon1, lat2, lon2])
        dlat = lat2 - lat1
        dlon = lon2 - lon1
        
        a = math.sin(dlat/2)**2 + math.cos(lat1) * math.cos(lat2) * math.sin(dlon/2)**2
        c = 2 * math.asin(math.sqrt(a))
        
        return R * c
    
    def generate_report(self, lat: float, lon: float, altitude: float):
        """Generate human-readable compliance report"""
        result = self.check_location(lat, lon, altitude)
        
        print("\n" + "="*60)
        print("AIRSPACE COMPLIANCE CHECK")
        print("="*60)
        print(f"Location: {lat:.6f}, {lon:.6f}")
        print(f"Altitude: {altitude} feet AGL")
        print(f"Airspace Class: {result['airspace_class']}")
        print(f"LAANC Required: {'YES' if result['laanc_required'] else 'NO'}")
        
        if result['nearest_airport']:
            airport = result['nearest_airport']
            print(f"\nNearest Airport: {airport['name']} ({airport['class']})")
            print(f"Distance: {airport['distance']:.1f} nautical miles")
        
        print(f"\nCOMPLIANCE STATUS: {'✅ PASS' if result['compliant'] else '❌ FAIL'}")
        
        if result['errors']:
            print("\n❌ ERRORS:")
            for error in result['errors']:
                print(f"  - {error}")
        
        if result['warnings']:
            print("\n⚠️  WARNINGS:")
            for warning in result['warnings']:
                print(f"  - {warning}")
        
        if result['compliant'] and not result['warnings']:
            print("\n✅ Safe to fly at this location!")
        
        print("="*60 + "\n")
        
        return result


