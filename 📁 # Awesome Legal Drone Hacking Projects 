## 🎨 Project 3: LED Light Show Choreography

**Difficulty:** Intermediate  
**Time:** 1 week  
**Legal Status:** ✅ Legal (on your property, under 400ft)

### Overview:
Program synchronized LED light shows with multiple drones.

### Hardware:
- WS2812B LED strips
- Arduino/ESP32 controller
- Custom drone frames with LED mounts

### Choreography Code:
```python
import numpy as np
import time

class DroneShowChoreographer:
    def __init__(self, num_drones=5):
        self.num_drones = num_drones
        self.drones = []
        self.timeline = []
        
    def add_formation(self, time, formation_type, **params):
        """Add formation change to timeline"""
        self.timeline.append({
            'time': time,
            'type': formation_type,
            'params': params
        })
    
    def circle_formation(self, radius=10, height=10):
        """Generate circle formation positions"""
        positions = []
        for i in range(self.num_drones):
            angle = 2 * np.pi * i / self.num_drones
            x = radius * np.cos(angle)
            y = radius * np.sin(angle)
            z = height
            positions.append((x, y, z))
        return positions
    
    def spiral_formation(self, radius=10, height_range=(5, 15)):
        """Generate spiral formation"""
        positions = []
        for i in range(self.num_drones):
            angle = 2 * np.pi * i / self.num_drones
            r = radius * (i / self.num_drones)
            h = height_range[0] + (height_range[1] - height_range[0]) * (i / self.num_drones)
            x = r * np.cos(angle)
            y = r * np.sin(angle)
            z = h
            positions.append((x, y, z))
        return positions
    
    def wave_pattern(self, time_offset, amplitude=5, frequency=0.5):
        """Generate wave motion"""
        positions = []
        for i in range(self.num_drones):
            x = i * 3 - (self.num_drones * 3) / 2
            y = 0
            z = 10 + amplitude * np.sin(2 * np.pi * frequency * time_offset + i)
            positions.append((x, y, z))
        return positions
    
    def led_pattern(self, pattern_type, time_offset):
        """Generate LED color patterns"""
        colors = []
        
        if pattern_type == 'rainbow':
            for i in range(self.num_drones):
                hue = (i / self.num_drones + time_offset) % 1.0
                colors.append(self.hsv_to_rgb(hue, 1.0, 1.0))
                
        elif pattern_type == 'pulse':
            brightness = (np.sin(2 * np.pi * time_offset) + 1) / 2
            colors = [(255 * brightness, 0, 0)] * self.num_drones
            
        elif pattern_type == 'wave':
            for i in range(self.num_drones):
                brightness = (np.sin(2 * np.pi * (time_offset + i/self.num_drones)) + 1) / 2
                colors.append((0, int(255 * brightness), 255))
        
        return colors
    
    def hsv_to_rgb(self, h, s, v):
        """Convert HSV to RGB"""
        import colorsys
        r, g, b = colorsys.hsv_to_rgb(h, s, v)
        return (int(r * 255), int(g * 255), int(b * 255))
    
    def generate_show(self, duration=60):
        """Generate complete show sequence"""
        show_sequence = []
        
        # Example show choreography
        formations = [
            (0, 'circle', {'radius': 10}),
            (10, 'spiral', {'radius': 15}),
            (20, 'line', {}),
            (30, 'wave', {'amplitude': 5}),
            (40, 'circle', {'radius': 8}),
            (50, 'land', {})
        ]
        
        for timestamp, formation, params in formations:
            show_sequence.append({
                'time': timestamp,
                'formation': formation,
                'params': params
            })
        
        return show_sequence
    
    def save_choreography(self, filename):
        """Save show to file"""
        import json
        with open(filename, 'w') as f:
            json.dump(self.timeline, f, indent=2)
        print(f"Choreography saved to {filename}")

# Example usage
choreographer = DroneShowChoreographer(num_drones=5)

# Create a 60-second show
print("Creating light show choreography...")

# Add formations
choreographer.add_formation(0, 'takeoff', height=10)
choreographer.add_formation(5, 'circle', radius=10)
choreographer.add_formation(15, 'spiral', radius=15)
choreographer.add_formation(25, 'wave', amplitude=5)
choreographer.add_formation(40, 'circle', radius=8)
choreographer.add_formation(55, 'land')

choreographer.save_choreography('light_show.json')
```

