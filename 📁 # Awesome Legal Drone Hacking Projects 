## 🤖 Project 2: AI-Powered Object Following

**Difficulty:** Intermediate  
**Time:** 1-2 weeks  
**Legal Status:** ✅ Legal (on your property, following your own objects)

### Overview:
Train a drone to autonomously follow a person or object using computer vision.

### Features:
- YOLOv8 object detection
- Kalman filter for smooth tracking
- Proportional control for positioning
- Safe distance maintenance

### Complete Code:
```python
from ultralytics import YOLO
import cv2
import numpy as np
from dronekit import connect, VehicleMode

class ObjectFollower:
    def __init__(self, drone_connection, target_class='person'):
        self.vehicle = connect(drone_connection)
        self.model = YOLO('yolov8n.pt')
        self.target_class = target_class
        self.following = False
        
        # Control parameters
        self.kp_x = 0.5  # Proportional gain for X
        self.kp_y = 0.5  # Proportional gain for Y
        self.kp_z = 0.3  # Proportional gain for Z (altitude)
        self.target_distance = 5.0  # meters
        
    def detect_target(self, frame):
        """Detect target object in frame"""
        results = self.model(frame, classes=[0])  # 0 = person
        
        if len(results[0].boxes) == 0:
            return None
        
        # Get largest detection
        boxes = results[0].boxes
        largest = max(boxes, key=lambda b: 
                     (b.xyxy[0][2] - b.xyxy[0][0]) * 
                     (b.xyxy[0][3] - b.xyxy[0][1]))
        
        x1, y1, x2, y2 = largest.xyxy[0].cpu().numpy()
        center_x = (x1 + x2) / 2
        center_y = (y1 + y2) / 2
        width = x2 - x1
        height = y2 - y1
        
        return {
            'center': (center_x, center_y),
            'size': (width, height),
            'bbox': (x1, y1, x2, y2)
        }
    
    def calculate_velocity(self, detection, frame_shape):
        """Calculate velocity commands based on detection"""
        if detection is None:
            return 0, 0, 0
        
        frame_h, frame_w = frame_shape[:2]
        center_x, center_y = detection['center']
        width, height = detection['size']
        
        # Calculate offsets from center
        offset_x = (center_x - frame_w/2) / (frame_w/2)
        offset_y = (center_y - frame_h/2) / (frame_h/2)
        
        # Estimate distance based on object size
        # (larger object = closer)
        size_ratio = (width * height) / (frame_w * frame_h)
        distance_error = size_ratio - 0.15  # Target 15% of frame
        
        # Calculate velocities
        vx = -offset_y * self.kp_y * 2  # Forward/back
        vy = offset_x * self.kp_x * 2   # Left/right
        vz = distance_error * self.kp_z  # Up/down
        
        # Limit velocities
        vx = np.clip(vx, -3, 3)
        vy = np.clip(vy, -3, 3)
        vz = np.clip(vz, -1, 1)
        
        return vx, vy, vz
    
    def follow(self, camera_index=0):
        """Main following loop"""
        cap = cv2.VideoCapture(camera_index)
        
        print("Starting object following...")
        print("Press 's' to start/stop following")
        print("Press 'q' to quit")
        
        while True:
            ret, frame = cap.read()
            if not ret:
                break
            
            # Detect target
            detection = self.detect_target(frame)
            
            # Draw detection
            if detection:
                x1, y1, x2, y2 = detection['bbox']
                cv2.rectangle(frame, (int(x1), int(y1)), 
                            (int(x2), int(y2)), (0, 255, 0), 2)
                
                if self.following:
                    # Calculate and send velocity
                    vx, vy, vz = self.calculate_velocity(
                        detection, frame.shape
                    )
                    
                    self.send_velocity(vx, vy, vz)
                    
                    # Display velocities
                    cv2.putText(frame, f"VX: {vx:.2f} VY: {vy:.2f} VZ: {vz:.2f}",
                              (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 
                              0.7, (0, 255, 0), 2)
            
            # Display status
            status = "FOLLOWING" if self.following else "TRACKING"
            color = (0, 255, 0) if self.following else (0, 255, 255)
            cv2.putText(frame, status, (10, frame.shape[0] - 10),
                       cv2.FONT_HERSHEY_SIMPLEX, 1, color, 2)
            
            cv2.imshow('Object Following', frame)
            
            # Handle keys
            key = cv2.waitKey(1) & 0xFF
            if key == ord('q'):
                break
            elif key == ord('s'):
                self.following = not self.following
                print(f"Following: {self.following}")
        
        cap.release()
        cv2.destroyAllWindows()
        
    def send_velocity(self, vx, vy, vz):
        """Send velocity command to drone"""
        # NED frame: vx=forward, vy=right, vz=down
        self.vehicle.mav.set_position_target_local_ned_send(
            0,
            self.vehicle.target_system,
            self.vehicle.target_component,
            mavutil.mavlink.MAV_FRAME_BODY_OFFSET_NED,
            0b0000111111000111,
            0, 0, 0,
            vx, vy, -vz,  # Invert Z for down=positive
            0, 0, 0, 0, 0
        )

# Usage
if __name__ == "__main__":
    follower = ObjectFollower('udp:127.0.0.1:14550', target_class='person')
    follower.follow()
```

### Safety Features:
- Maximum velocity limits
- Lost target timeout
- Emergency stop key
- Visual confirmation required

