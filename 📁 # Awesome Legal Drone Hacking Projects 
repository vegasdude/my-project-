### Automated Mission Code:
```python
from dronekit import connect, VehicleMode, LocationGlobalRelative, Command
from pymavlink import mavutil
import math

class PhotogrammetryMission:
    def __init__(self, vehicle):
        self.vehicle = vehicle
        
    def create_grid_mission(self, center_lat, center_lon, 
                           grid_size=100, overlap=0.7, altitude=50):
        """
        Create automated grid mission for photogrammetry
        
        Args:
            center_lat/lon: Center of area
            grid_size: Size in meters
            overlap: Photo overlap percentage (0.7 = 70%)
            altitude: Flight altitude
        """
        # Calculate photo footprint
        # (depends on camera specs)
        sensor_width = 6.17  # mm
        focal_length = 4.5   # mm
        image_width = 4000   # pixels
        
        ground_width = (sensor_width * altitude) / focal_length
        spacing = ground_width * (1 - overlap)
        
        # Calculate number of passes
        num_passes = int(grid_size / spacing) + 1
        
        # Create waypoints
        waypoints = []
        for i in range(num_passes):
            offset = (i - num_passes/2) * spacing
            
            # Alternate direction for efficiency
            if i % 2 == 0:
                start_lon = center_lon - grid_size/2
                end_lon = center_lon + grid_size/2
            else:
                start_lon = center_lon + grid_size/2
                end_lon = center_lon - grid_size/2
            
            lat = center_lat + offset / 111320  # meters to degrees
            
            waypoints.append((lat, start_lon, altitude))
            waypoints.append((lat, end_lon, altitude))
        
        return waypoints
    
    def upload_mission(self, waypoints, trigger_distance=5):
        """Upload mission with camera triggers"""
        cmds = self.vehicle.commands
        cmds.clear()
        
        # Add takeoff
        home = self.vehicle.location.global_frame
        cmds.add(Command(0, 0, 0,
                        mavutil.mavlink.MAV_FRAME_GLOBAL_RELATIVE_ALT,
                        mavutil.mavlink.MAV_CMD_NAV_TAKEOFF,
                        0, 0, 0, 0, 0, 0,
                        home.lat, home.lon, waypoints[0][2]))
        
        # Add waypoints with camera triggers
        for lat, lon, alt in waypoints:
            # Waypoint
            cmds.add(Command(0, 0, 0,
                           mavutil.mavlink.MAV_FRAME_GLOBAL_RELATIVE_ALT,
                           mavutil.mavlink.MAV_CMD_NAV_WAYPOINT,
                           0, 0, 0, 0, 0, 0,
                           lat, lon, alt))
            
            # Camera trigger (distance-based)
            cmds.add(Command(0, 0, 0,
                           mavutil.mavlink.MAV_FRAME_MISSION,
                           mavutil.mavlink.MAV_CMD_DO_SET_CAM_TRIGG_DIST,
                           0, 0, trigger_distance, 0, 0, 0,
                           0, 0, 0))
        
        # RTL
        cmds.add(Command(0, 0, 0,
                        mavutil.mavlink.MAV_FRAME_GLOBAL_RELATIVE_ALT,
                        mavutil.mavlink.MAV_CMD_NAV_RETURN_TO_LAUNCH,
                        0, 0, 0, 0, 0, 0, 0, 0, 0))
        
        cmds.upload()
        print(f"Uploaded {len(cmds)} commands")
```

